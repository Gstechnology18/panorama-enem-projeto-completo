PANORAMA_ENV=development
PANORAMA_DATA_MODE=auto
# Gold do ETL (repositório enem_projeto_aplicado). Com os dois repositórios lado a lado:
PANORAMA_GOLD_PATH=../enem_projeto_aplicado/data/gold/enem_notas.parquet
PANORAMA_PARQUET_GLOB=backend/data/parquet/ano=*/enem.parquet
PANORAMA_DEMO_CSV=backend/data/demo/enem_demo.csv
PANORAMA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PANORAMA_API_PREFIX=/api/v1
